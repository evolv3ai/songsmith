{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Songsmith Studio",
  "version": "0.1.0",
  "identifier": "com.songsmithstudio.desktop",
  "build": {
    "frontendDist": "../../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build"
  },
  "app": {
    "windows": [
      {
        "title": "Songsmith Studio",
        "width": 1320,
        "height": 880,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "resources": {
      "../../target/release/mcp-shim": "mcp-shim"
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}